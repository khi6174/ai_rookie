# Server-only secrets. Never prefix these variables with VITE_.
UPSTAGE_API_KEY=

# Approve the exact model before enabling Live. The current official console
# example uses solar-pro3, but this repository does not silently select it.
UPSTAGE_MODEL=

UPSTAGE_CHAT_COMPLETIONS_URL=https://api.upstage.ai/v1/chat/completions
UPSTAGE_DOCUMENT_PARSE_URL=https://api.upstage.ai/v1/document-digitization
UPSTAGE_DOCUMENT_PARSE_TIMEOUT_MS=60000

# Operational values must be chosen explicitly before Live enablement.
# Suggested first smoke values: 10000, 32000, 64000.
UPSTAGE_TIMEOUT_MS=
UPSTAGE_MAX_PROMPT_BYTES=
UPSTAGE_MAX_RESPONSE_BYTES=

# Domestic AI API comparison benchmark. These values are server-only and are
# not required for the deterministic Mock baseline. Do not guess endpoints:
# copy the exact HTTPS host, path, model, and Bearer auth contract from the
# provider-issued documentation. The initial adapter supports only explicit
# OpenAI-compatible /v1/chat/completions endpoints.
DOMESTIC_AI_TIMEOUT_MS=
DOMESTIC_AI_MAX_PROMPT_BYTES=
DOMESTIC_AI_MAX_RESPONSE_BYTES=

AX_API_KEY=
# AI One Portal A.X K1 API guide v1.3: A.X-K1
AX_MODEL=
# Official base URL: https://awf-gw.adot.ai/v1
AX_CHAT_COMPLETIONS_URL=https://awf-gw.adot.ai/v1/chat/completions
AX_ALLOWED_HOST=awf-gw.adot.ai

EXAONE_API_KEY=
# Competition guide: LGAI-EXAONE/K-EXAONE-236B-A23B
EXAONE_MODEL=
# Competition guide base URL: https://api.friendli.ai/serverless/v1
EXAONE_CHAT_COMPLETIONS_URL=https://api.friendli.ai/serverless/v1/chat/completions
EXAONE_ALLOWED_HOST=api.friendli.ai

# VARCO is intentionally excluded from the shared text-generation benchmark.
# The competition guide presents VARCO as downstream asset APIs (3D, Sound,
# Voice, Translation, etc.), not as the same OpenAI-compatible text LLM role.

# KMA API Hub 4.1 observation and 4.2 forecast adapters (DS-001). Server-only;
# never prefix with VITE_. Keep the issued auth key local and do not commit it.
KMA_API_HUB_AUTH_KEY=
KMA_ULTRA_SHORT_OBSERVATION_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0/getUltraSrtNcst
KMA_ULTRA_SHORT_FORECAST_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0/getUltraSrtFcst
KMA_ALLOWED_HOST=apihub.kma.go.kr
KMA_TIMEOUT_MS=10000
KMA_MAX_RESPONSE_BYTES=200000
KMA_MAX_AGE_MINUTES=120

# Approved supplement APIs DS-005 1.3 and DS-006 4.3 reuse the same server-only
# auth key. Their official URLs are exact constants and cannot be overridden.
# Optional coarse Demo grid for the opt-in Live smoke. No exact address or
# courier trajectory is stored. Defaults match the synthetic Seoul Demo grid.
KMA_SMOKE_AREA_ID=demo-seoul-grid-60-127
KMA_SMOKE_GRID_X=60
KMA_SMOKE_GRID_Y=127

# TAAS REST JSON public-data adapters. TAAS_API_KEY can be shared after both
# APIs are registered to that portal key; per-API overrides remain supported.
# Keys may be stored raw or in the URL-encoded form issued by the portal.
TAAS_API_KEY=
TAAS_TRUCK_API_KEY=
TAAS_STATS_API_KEY=
TAAS_TRUCK_URL=https://opendata.koroad.or.kr/data/rest/frequentzone/truck
TAAS_STATS_URL=https://opendata.koroad.or.kr/data/rest/stt
TAAS_ALLOWED_HOST=opendata.koroad.or.kr
TAAS_TIMEOUT_MS=10000
TAAS_MAX_RESPONSE_BYTES=500000

# Browser-visible Kakao Maps JavaScript platform key. This is not a server API
# secret: restrict it to approved JavaScript SDK domains in Kakao Developers.
# Never place a Kakao REST API key or Admin key in a VITE_ variable.
VITE_KAKAO_MAP_JAVASCRIPT_KEY=
# Set false in deterministic E2E or when an explicit schematic-only run is needed.
VITE_KAKAO_MAP_ENABLED=true

# Server-only Kakao Mobility Directions key. Never expose this through VITE_.
KAKAO_MOBILITY_REST_API_KEY=
KAKAO_DIRECTIONS_ENABLED=true
