{
  "name": "saferoute-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite",
    "build": "node scripts/build-operations-document-template.mjs --verify && tsc --noEmit && vite build && node scripts/build-sites-worker.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-playwright.ps1",
    "test:e2e:headed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-playwright.ps1 --headed",
    "test:e2e:clean-start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-clean-start-rehearsal.ps1",
    "verify:final": "node scripts/run-final-readiness-audit.mjs",
    "audit:goal": "node scripts/run-goal-completion-audit.mjs",
    "audit:goal:require-ready": "node scripts/run-goal-completion-audit.mjs --require-ready",
    "package:submission": "node scripts/build-submission-package.mjs",
    "eval:core-artifacts": "node scripts/run-core-eval-artifacts.mjs",
    "eval:upstage:smoke": "node scripts/run-upstage-smoke.mjs",
    "eval:upstage:smoke:mock": "node scripts/run-upstage-smoke.mjs --mock",
    "eval:upstage:documents:mock": "node scripts/run-upstage-document-roundtrip.mjs --mock",
    "eval:upstage:operations-documents:check": "node scripts/run-upstage-operations-document-live.mjs --check",
    "eval:upstage:operations-documents:live": "node scripts/run-upstage-operations-document-live.mjs --live",
    "eval:domestic-ai:smoke": "node scripts/run-domestic-ai-smoke.mjs",
    "eval:domestic-ai:smoke:mock": "node scripts/run-domestic-ai-smoke.mjs --mock",
    "eval:domestic-ai:check": "node scripts/run-domestic-ai-smoke.mjs --check",
    "eval:domestic-ai:cascade:mock": "node scripts/run-domestic-ai-cascade.mjs --mock",
    "eval:domestic-track:audit": "node scripts/run-domestic-track-audit.mjs",
    "eval:kma-weather:check": "node scripts/run-kma-weather-smoke.mjs --check",
    "eval:kma-weather:mock": "node scripts/run-kma-weather-smoke.mjs --mock",
    "eval:kma-weather:live": "node scripts/run-kma-weather-smoke.mjs --live",
    "eval:kma-weather:coverage": "node scripts/run-kma-weather-coverage.mjs",
    "eval:kma-weather:supplement:diagnose": "node scripts/run-kma-supplement-diagnostic.mjs",
    "eval:kma-weather:supplement:live": "node scripts/run-kma-supplement-smoke.mjs",
    "eval:kma-weather:runtime": "node scripts/run-weather-runtime-audit.mjs",
    "eval:kakao:directions:live": "node scripts/run-kakao-directions-smoke.mjs",
    "eval:operations:scale": "node scripts/run-operations-scale-evaluation.mjs",
    "eval:operations:human": "node scripts/run-operations-human-review-summary.mjs",
    "eval:operations:evidence": "node scripts/run-operations-service-evidence.mjs",
    "eval:operations:deployed:check": "node scripts/run-deployed-operations-smoke.mjs --check",
    "eval:operations:deployed:live": "node scripts/run-deployed-operations-smoke.mjs --live",
    "audit:service-goal": "node scripts/run-service-goal-readiness.mjs",
    "eval:taas:check": "node scripts/run-taas-smoke.mjs --check",
    "eval:taas:mock": "node scripts/run-taas-smoke.mjs --mock",
    "eval:taas:live": "node scripts/run-taas-smoke.mjs --live",
    "data:synthetic:operations": "node scripts/run-synthetic-operations-documents.mjs",
    "data:synthetic:cascade": "node scripts/run-synthetic-cascade-training-dataset.mjs",
    "data:synthetic:cascade:v2": "node scripts/run-synthetic-cascade-training-dataset-v2.mjs",
    "data:operations:document-template": "node scripts/build-operations-document-template.mjs",
    "eval:a100:operations:prepare": "node scripts/prepare-a100-operations-documents.mjs",
    "eval:a100:cascade:lora:check": "python scripts/train-ax-cascade-lora.py",
    "eval:a100:cascade:lora:v2:check": "python scripts/train-ax-cascade-lora.py --config config/a100-cascade-lora-v2.json",
    "eval:a100:cascade:lora:validation:self-test": "python scripts/evaluate-ax-cascade-lora.py --self-test",
    "eval:a100:cascade:lora:frozen:self-test": "python scripts/evaluate-ax-cascade-lora-frozen.py --self-test",
    "eval:a100:cascade:lora:evidence:verify": "node scripts/verify-ax-cascade-lora-evidence.mjs",
    "eval:a100:cascade:product-review:prepare": "node scripts/prepare-ax-cascade-product-review.mjs",
    "eval:a100:cascade:product-review:local:self-test": "python scripts/evaluate-ax-cascade-product-review-local.py --self-test",
    "eval:a100:cascade:product-review:assemble": "node scripts/assemble-ax-cascade-product-review.mjs",
    "eval:g5:comprehension": "node scripts/run-spatial-comprehension.mjs",
    "eval:rider-reference:stimulus": "node scripts/build-rider-reference-stimulus.mjs",
    "eval:rider-reference:comprehension": "node scripts/run-rider-reference-comprehension.mjs",
    "eval:a11y": "node scripts/run-a11y-audit.mjs",
    "review:g5": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "review:rider-reference": "vite --host 127.0.0.1 --port 4175 --strictPort"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
