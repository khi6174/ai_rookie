# Large generated media and editable submission sources are stored through Git LFS.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.aac filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.hwp filter=lfs diff=lfs merge=lfs -text
*.hwpx filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text

# Exact text extractions from legacy Korean office formats retain their source encoding.
/deliverables/final_submission/converted/*.txt binary
